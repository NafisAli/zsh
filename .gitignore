# Plugin clones -- recreated automatically by plugins.zsh on first shell start
plugins/

# Runtime state. History and the completion cache live under the XDG dirs, but
# /etc/zshrc points HISTFILE at $ZDOTDIR/.zsh_history before .zshrc overrides
# it, so a stray history file can reappear in this directory.
.zsh_history
.zcompdump*
*.zwc
.zsh_sessions/

# Machine-local overrides -- work scripts, per-host aliases. Never committed;
# promote a file by moving it out of local/ and committing it.
local/

# macOS Finder metadata
.DS_Store
